# PostgreSQL
POSTGRES_USER=edutrack
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=edutrack

# Local PDF question extraction
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_CONTEXT_WINDOW=32768
OLLAMA_MAX_INPUT_CHARS=70000

# "mps" is recommended for Apple Silicon; use "auto" for portability.
DOCLING_DEVICE=mps
DOCLING_TIMEOUT_SECONDS=120
PDF_MAX_PAGES=100
PDF_MAX_UPLOAD_MB=25

# Still required by the inherited GPT question-generation endpoint.
OPEN_AI_API_KEY=
